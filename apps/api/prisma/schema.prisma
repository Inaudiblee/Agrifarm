generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BUYER
  SELLER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum FarmerGender {
  MALE
  FEMALE
}

enum StoreStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
  CLOSED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  OUT_OF_STOCK
  ARCHIVED
}

enum OrderStatus {
  PENDING_PAYMENT
  RESERVED
  COMPLETED
  EXPIRED
  PENDING
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum SellerOrderStatus {
  RESERVED
  COMPLETED
  EXPIRED
  PENDING
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  CASH_ON_PICKUP
  CASH_ON_DELIVERY
  GCASH
  MAYA
  CARD
  BANK_TRANSFER
}

enum FulfillmentStatus {
  PENDING
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  FAILED
  CANCELLED
}

enum InventoryChangeReason {
  RESERVATION
  RESERVATION_RELEASE
  PICKUP_COMPLETION
  INITIAL_STOCK
  RESTOCK
  SALE
  RETURN
  ADJUSTMENT
  DAMAGE
  CANCELLATION
}

enum FinancialTransactionType {
  SALE
  COMMISSION
  REFUND
  PAYOUT
  ADJUSTMENT
}

enum CommissionPlanStatus {
  ACTIVE
  INACTIVE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  STATUS_CHANGE
  APPROVAL
  REJECTION
  PAYOUT
  REFUND
}

enum NotificationType {
  ORDER_UPDATE
  PAYMENT_UPDATE
  FULFILLMENT_UPDATE
  INVENTORY_ALERT
  ACCOUNT_UPDATE
  SYSTEM
}

enum FarmingSiteType {
  BACKYARD
  COMMUNITY_GARDEN
  ROOFTOP
  SCHOOL_GARDEN
  INSTITUTIONAL
  COMMERCIAL
  OTHER
}

enum CultivationStatus {
  PLANNED
  PLANTED
  GROWING
  HARVESTING
  COMPLETED
  CANCELLED
}

model User {
  id                   String            @id @default(cuid())
  email                String            @unique @db.VarChar(255)
  passwordHash         String
  fullName             String            @db.VarChar(255)
  phone                String?           @db.VarChar(30)
  role                 UserRole          @default(BUYER)
  status               UserStatus        @default(ACTIVE)
  emailVerifiedAt      DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  deletedAt            DateTime?
  sellerProfile        SellerProfile?
  addresses            Address[]
  carts                Cart[]
  orders               Order[]           @relation("BuyerOrders")
  assignedFulfillments Fulfillment[]     @relation("AssignedRider")
  inventoryChanges     InventoryLedger[]
  reviews              Review[]
  auditLogs            AuditLog[]
  notifications        Notification[]
  refreshTokens        RefreshToken[]

  @@index([role])
  @@index([status])
  @@index([createdAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique @db.VarChar(128)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model SellerProfile {
  id           String        @id @default(cuid())
  userId       String        @unique
  businessName String        @db.VarChar(255)
  gender       FarmerGender?
  avatarKey    String?       @db.VarChar(20)
  verifiedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  stores       Store[]
}

model Store {
  id              String                 @id @default(cuid())
  sellerProfileId String
  name            String                 @db.VarChar(160)
  slug            String                 @unique @db.VarChar(180)
  description     String?
  status          StoreStatus            @default(DRAFT)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  deletedAt       DateTime?
  sellerProfile   SellerProfile          @relation(fields: [sellerProfileId], references: [id], onDelete: Restrict)
  products        Product[]
  productVariants ProductVariant[]       @relation("StoreProductVariants")
  sellerOrders    SellerOrder[]
  commissionRules StoreCommission[]
  financialLedger FinancialTransaction[]
  serviceAreas    StoreServiceArea[]

  @@index([sellerProfileId])
  @@index([status])
}

model Barangay {
  id             String                        @id @default(cuid())
  name           String                        @db.VarChar(120)
  normalizedName String                        @unique @db.VarChar(120)
  city           String                        @default("Pasig") @db.VarChar(120)
  province       String                        @default("Metro Manila") @db.VarChar(120)
  isActive       Boolean                       @default(true)
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt
  addresses      Address[]
  storeAreas     StoreServiceArea[]
  urbanFarmers   UrbanFarmer[]
  farmingSites   FarmingSite[]
  associations   FarmingAssociation[]
  cropCalendars  SeasonalCropCalendar[]
  marketPrices   MarketPriceObservation[]
  availability   CropAvailabilityObservation[]
  supplyReports  SupplyReport[]
  salesRecords   AgriculturalSaleRecord[]
  statistics     AgriculturalStatistic[]

  @@index([city, province])
  @@index([isActive])
}

model StoreServiceArea {
  id          String   @id @default(cuid())
  storeId     String
  barangayId  String
  deliveryFee Decimal  @default(0) @db.Decimal(12, 2)
  minOrder    Decimal? @db.Decimal(12, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  barangay    Barangay @relation(fields: [barangayId], references: [id], onDelete: Restrict)

  @@unique([storeId, barangayId])
  @@index([barangayId])
  @@index([isActive])
}

model Category {
  id          String            @id @default(cuid())
  parentId    String?
  name        String            @db.VarChar(120)
  slug        String            @unique @db.VarChar(140)
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  parent      Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[]        @relation("CategoryTree")
  products    ProductCategory[]

  @@index([parentId])
}

model Product {
  id           String                   @id @default(cuid())
  storeId      String
  name         String                   @db.VarChar(255)
  slug         String                   @db.VarChar(280)
  description  String?
  status       ProductStatus            @default(DRAFT)
  searchVector Unsupported("tsvector")?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  deletedAt    DateTime?
  store        Store                    @relation(fields: [storeId], references: [id], onDelete: Restrict)
  variants     ProductVariant[]
  categories   ProductCategory[]
  images       ProductImage[]
  reviews      Review[]

  @@unique([storeId, slug])
  @@unique([id, storeId])
  @@index([storeId])
  @@index([status])
  @@index([createdAt])
}

model ProductVariant {
  id                String            @id @default(cuid())
  productId         String
  storeId           String
  name              String            @db.VarChar(120)
  sku               String?           @db.VarChar(120)
  unit              String            @default("kg") @db.VarChar(30)
  price             Decimal           @db.Decimal(12, 2)
  compareAtPrice    Decimal?          @db.Decimal(12, 2)
  stockOnHand       Int               @default(0)
  totalStock        Int               @default(0)
  availableStock    Int               @default(0)
  reservedStock     Int               @default(0)
  lowStockThreshold Int               @default(5)
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  store             Store             @relation("StoreProductVariants", fields: [storeId], references: [id], onDelete: Restrict)
  product           Product           @relation(fields: [productId, storeId], references: [id, storeId], onDelete: Cascade)
  cartItems         CartItem[]
  orderItems        OrderItem[]
  inventoryLedger   InventoryLedger[]

  @@unique([productId, name])
  @@unique([id, storeId])
  @@unique([storeId, sku])
  @@index([productId])
  @@index([storeId])
  @@index([price])
  @@index([isActive])
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
}

model ProductImage {
  id           String   @id @default(cuid())
  productId    String
  url          String
  altText      String?  @db.VarChar(255)
  displayOrder Int      @default(0)
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Address {
  id            String    @id @default(cuid())
  userId        String
  barangayId    String?
  label         String?   @db.VarChar(80)
  recipientName String    @db.VarChar(255)
  phone         String    @db.VarChar(30)
  street        String
  barangay      String    @db.VarChar(120)
  city          String    @db.VarChar(120)
  province      String    @db.VarChar(120)
  postalCode    String?   @db.VarChar(20)
  country       String    @default("Philippines") @db.VarChar(80)
  latitude      Decimal?  @db.Decimal(10, 7)
  longitude     Decimal?  @db.Decimal(10, 7)
  isDefault     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  barangayRef   Barangay? @relation(fields: [barangayId], references: [id], onDelete: Restrict)
  orders        Order[]

  @@unique([id, userId])
  @@index([userId])
  @@index([barangayId])
  @@index([city, province])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@unique([userId])
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId])
  @@index([variantId])
}

model Order {
  id                String                 @id @default(cuid())
  orderNumber       String                 @unique @db.VarChar(40)
  buyerId           String
  shippingAddressId String?
  status            OrderStatus            @default(PENDING_PAYMENT)
  paymentStatus     PaymentStatus          @default(PENDING)
  subtotal          Decimal                @db.Decimal(12, 2)
  deliveryFee       Decimal                @default(0) @db.Decimal(12, 2)
  discountTotal     Decimal                @default(0) @db.Decimal(12, 2)
  grandTotal        Decimal                @db.Decimal(12, 2)
  depositAmount     Decimal                @default(0) @db.Decimal(12, 2)
  remainingBalance  Decimal                @default(0) @db.Decimal(12, 2)
  pickupScheduledAt DateTime?
  expiresAt         DateTime?
  clearCartOnPaid   Boolean                @default(false)
  notes             String?
  placedAt          DateTime               @default(now())
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  cancelledAt       DateTime?
  buyer             User                   @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Restrict)
  shippingAddress   Address?               @relation(fields: [shippingAddressId, buyerId], references: [id, userId], onDelete: Restrict)
  items             OrderItem[]
  sellerOrders      SellerOrder[]
  payments          Payment[]
  financialLedger   FinancialTransaction[]

  @@index([buyerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([placedAt])
  @@index([pickupScheduledAt])
  @@index([expiresAt])
}

model SellerOrder {
  id               String                 @id @default(cuid())
  orderId          String
  storeId          String
  status           SellerOrderStatus      @default(PENDING)
  subtotal         Decimal                @db.Decimal(12, 2)
  deliveryFee      Decimal                @default(0) @db.Decimal(12, 2)
  commissionFee    Decimal                @default(0) @db.Decimal(12, 2)
  payoutAmount     Decimal                @db.Decimal(12, 2)
  remainingBalance Decimal                @default(0) @db.Decimal(12, 2)
  balancePaidAt    DateTime?
  confirmedAt      DateTime?
  cancelledAt      DateTime?
  deliveredAt      DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  order            Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  store            Store                  @relation(fields: [storeId], references: [id], onDelete: Restrict)
  items            OrderItem[]
  fulfillment      Fulfillment?
  financialLedger  FinancialTransaction[]

  @@unique([orderId, storeId])
  @@unique([id, storeId])
  @@index([orderId])
  @@index([storeId])
  @@index([status])
}

model OrderItem {
  id            String         @id @default(cuid())
  orderId       String
  sellerOrderId String
  variantId     String
  storeId       String
  productName   String         @db.VarChar(255)
  variantName   String         @db.VarChar(120)
  unit          String         @db.VarChar(30)
  quantity      Int
  unitPrice     Decimal        @db.Decimal(12, 2)
  subtotal      Decimal        @db.Decimal(12, 2)
  createdAt     DateTime       @default(now())
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerOrder   SellerOrder    @relation(fields: [sellerOrderId, storeId], references: [id, storeId], onDelete: Cascade)
  variant       ProductVariant @relation(fields: [variantId, storeId], references: [id, storeId], onDelete: Restrict)

  @@index([orderId])
  @@index([sellerOrderId])
  @@index([variantId])
  @@index([storeId])
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  amount      Decimal       @db.Decimal(12, 2)
  provider    String?       @db.VarChar(80)
  providerRef String?       @unique @db.VarChar(180)
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@index([method])
}

model Fulfillment {
  id            String            @id @default(cuid())
  sellerOrderId String            @unique
  riderId       String?
  status        FulfillmentStatus @default(PENDING)
  trackingCode  String?           @unique @db.VarChar(80)
  assignedAt    DateTime?
  pickedUpAt    DateTime?
  deliveredAt   DateTime?
  failedAt      DateTime?
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  sellerOrder   SellerOrder       @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)
  rider         User?             @relation("AssignedRider", fields: [riderId], references: [id], onDelete: SetNull)

  @@index([riderId])
  @@index([status])
}

model FinancialTransaction {
  id            String                   @id @default(cuid())
  storeId       String
  orderId       String?
  sellerOrderId String?
  type          FinancialTransactionType
  amount        Decimal                  @db.Decimal(12, 2)
  balanceAfter  Decimal                  @db.Decimal(12, 2)
  reference     String?                  @db.VarChar(160)
  notes         String?
  createdAt     DateTime                 @default(now())
  store         Store                    @relation(fields: [storeId], references: [id], onDelete: Restrict)
  order         Order?                   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  sellerOrder   SellerOrder?             @relation(fields: [sellerOrderId], references: [id], onDelete: SetNull)

  @@index([storeId])
  @@index([orderId])
  @@index([sellerOrderId])
  @@index([type])
  @@index([createdAt])
}

model CommissionPlan {
  id             String               @id @default(cuid())
  name           String               @db.VarChar(120)
  description    String?
  ratePercent    Decimal              @db.Decimal(5, 2)
  fixedFee       Decimal              @default(0) @db.Decimal(12, 2)
  status         CommissionPlanStatus @default(ACTIVE)
  effectiveFrom  DateTime             @default(now())
  effectiveUntil DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  storeRules     StoreCommission[]

  @@index([status])
  @@index([effectiveFrom, effectiveUntil])
}

model StoreCommission {
  id               String         @id @default(cuid())
  storeId          String
  commissionPlanId String
  startsAt         DateTime       @default(now())
  endsAt           DateTime?
  createdAt        DateTime       @default(now())
  store            Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  commissionPlan   CommissionPlan @relation(fields: [commissionPlanId], references: [id], onDelete: Restrict)

  @@index([storeId])
  @@index([commissionPlanId])
  @@index([startsAt, endsAt])
}

model InventoryLedger {
  id            String                @id @default(cuid())
  variantId     String
  changedById   String?
  reason        InventoryChangeReason
  quantityDelta Int
  quantityAfter Int
  referenceType String?               @db.VarChar(80)
  referenceId   String?               @db.VarChar(120)
  notes         String?
  createdAt     DateTime              @default(now())
  variant       ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Cascade)
  changedBy     User?                 @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([variantId])
  @@index([changedById])
  @@index([reason])
  @@index([createdAt])
}

model Review {
  id        String    @id @default(cuid())
  userId    String
  productId String
  rating    Int
  title     String?   @db.VarChar(160)
  comment   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@index([rating])
}

model AuditLog {
  id         String      @id @default(cuid())
  actorId    String?
  action     AuditAction
  entityType String      @db.VarChar(120)
  entityId   String?     @db.VarChar(120)
  metadata   Json?
  ipAddress  String?     @db.VarChar(45)
  userAgent  String?
  createdAt  DateTime    @default(now())
  actor      User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model TranslationOverride {
  id          String   @id @default(cuid())
  key         String   @db.VarChar(180)
  locale      String   @db.VarChar(10)
  value       String
  updatedById String?  @db.VarChar(255)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([key, locale])
  @@index([locale])
  @@index([updatedAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String           @db.VarChar(160)
  body      String?
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([type])
  @@index([createdAt])
}

model AgriculturalDataSource {
  id                       String                        @id @default(cuid())
  name                     String                        @db.VarChar(255)
  organization             String?                       @db.VarChar(255)
  referenceUrl             String?
  notes                    String?
  importedAt               DateTime                      @default(now())
  createdAt                DateTime                      @default(now())
  updatedAt                DateTime                      @updatedAt
  urbanFarmers             UrbanFarmer[]
  farmingSites             FarmingSite[]
  associations             FarmingAssociation[]
  crops                    Crop[]
  cultivations             CultivationRecord[]
  harvests                 HarvestRecord[]
  cropCalendars            SeasonalCropCalendar[]
  marketPrices             MarketPriceObservation[]
  availabilityObservations CropAvailabilityObservation[]
  supplyReports            SupplyReport[]
  salesRecords             AgriculturalSaleRecord[]
  statistics               AgriculturalStatistic[]

  @@index([organization])
  @@index([importedAt])
}

model UrbanFarmer {
  id                 String                     @id @default(cuid())
  barangayId         String
  sourceId           String?
  externalRecordId   String?                    @db.VarChar(160)
  registrationNumber String?                    @unique @db.VarChar(120)
  fullName           String                     @db.VarChar(255)
  registrationDate   DateTime?                  @db.Date
  isActive           Boolean                    @default(true)
  contactDetails     Json?
  attributes         Json?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  barangay           Barangay                   @relation(fields: [barangayId], references: [id], onDelete: Restrict)
  source             AgriculturalDataSource?    @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  associationLinks   FarmingAssociationMember[]
  siteLinks          FarmingSiteFarmer[]
  cultivations       CultivationRecord[]
  harvests           HarvestRecord[]
  salesRecords       AgriculturalSaleRecord[]

  @@unique([sourceId, externalRecordId])
  @@index([barangayId])
  @@index([sourceId])
  @@index([isActive])
}

model FarmingAssociation {
  id               String                     @id @default(cuid())
  barangayId       String?
  sourceId         String?
  externalRecordId String?                    @db.VarChar(160)
  name             String                     @db.VarChar(255)
  registrationNo   String?                    @unique @db.VarChar(120)
  establishedDate  DateTime?                  @db.Date
  isActive         Boolean                    @default(true)
  attributes       Json?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  barangay         Barangay?                  @relation(fields: [barangayId], references: [id], onDelete: Restrict)
  source           AgriculturalDataSource?    @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  members          FarmingAssociationMember[]
  sites            FarmingSite[]

  @@unique([sourceId, externalRecordId])
  @@index([barangayId])
  @@index([sourceId])
  @@index([isActive])
}

model FarmingAssociationMember {
  associationId String
  farmerId      String
  role          String?            @db.VarChar(120)
  joinedAt      DateTime?          @db.Date
  leftAt        DateTime?          @db.Date
  association   FarmingAssociation @relation(fields: [associationId], references: [id], onDelete: Cascade)
  farmer        UrbanFarmer        @relation(fields: [farmerId], references: [id], onDelete: Cascade)

  @@id([associationId, farmerId])
  @@index([farmerId])
}

model FarmingSite {
  id               String                        @id @default(cuid())
  barangayId       String
  associationId    String?
  sourceId         String?
  externalRecordId String?                       @db.VarChar(160)
  name             String                        @db.VarChar(255)
  siteType         FarmingSiteType
  address          String?
  areaSqm          Decimal?                      @db.Decimal(14, 2)
  latitude         Decimal?                      @db.Decimal(10, 7)
  longitude        Decimal?                      @db.Decimal(10, 7)
  establishedDate  DateTime?                     @db.Date
  isActive         Boolean                       @default(true)
  attributes       Json?
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt
  barangay         Barangay                      @relation(fields: [barangayId], references: [id], onDelete: Restrict)
  association      FarmingAssociation?           @relation(fields: [associationId], references: [id], onDelete: SetNull)
  source           AgriculturalDataSource?       @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  farmerLinks      FarmingSiteFarmer[]
  cultivations     CultivationRecord[]
  harvests         HarvestRecord[]
  cropCalendars    SeasonalCropCalendar[]
  availability     CropAvailabilityObservation[]
  salesRecords     AgriculturalSaleRecord[]
  statistics       AgriculturalStatistic[]

  @@unique([sourceId, externalRecordId])
  @@index([barangayId])
  @@index([associationId])
  @@index([sourceId])
  @@index([siteType])
  @@index([isActive])
}

model FarmingSiteFarmer {
  siteId    String
  farmerId  String
  role      String?     @db.VarChar(120)
  startedAt DateTime?   @db.Date
  endedAt   DateTime?   @db.Date
  site      FarmingSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  farmer    UrbanFarmer @relation(fields: [farmerId], references: [id], onDelete: Cascade)

  @@id([siteId, farmerId])
  @@index([farmerId])
}

model Crop {
  id               String                        @id @default(cuid())
  sourceId         String?
  externalRecordId String?                       @db.VarChar(160)
  commonName       String                        @db.VarChar(160)
  scientificName   String?                       @db.VarChar(255)
  variety          String?                       @db.VarChar(160)
  category         String?                       @db.VarChar(120)
  defaultUnit      String                        @default("kg") @db.VarChar(30)
  isActive         Boolean                       @default(true)
  attributes       Json?
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt
  source           AgriculturalDataSource?       @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  cultivations     CultivationRecord[]
  harvests         HarvestRecord[]
  cropCalendars    SeasonalCropCalendar[]
  marketPrices     MarketPriceObservation[]
  availability     CropAvailabilityObservation[]
  supplyReports    SupplyReport[]
  salesRecords     AgriculturalSaleRecord[]
  statistics       AgriculturalStatistic[]

  @@unique([commonName, variety])
  @@unique([sourceId, externalRecordId])
  @@index([sourceId])
  @@index([category])
  @@index([isActive])
}

model CultivationRecord {
  id                      String                  @id @default(cuid())
  siteId                  String
  cropId                  String
  farmerId                String?
  sourceId                String?
  externalRecordId        String?                 @db.VarChar(160)
  plantingDate            DateTime                @db.Date
  expectedHarvestDate     DateTime?               @db.Date
  completedAt             DateTime?               @db.Date
  status                  CultivationStatus       @default(PLANTED)
  areaPlantedSqm          Decimal?                @db.Decimal(14, 2)
  quantityPlanted         Decimal?                @db.Decimal(14, 3)
  plantingUnit            String?                 @db.VarChar(30)
  expectedHarvestQuantity Decimal?                @db.Decimal(14, 3)
  harvestUnit             String?                 @db.VarChar(30)
  attributes              Json?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  site                    FarmingSite             @relation(fields: [siteId], references: [id], onDelete: Restrict)
  crop                    Crop                    @relation(fields: [cropId], references: [id], onDelete: Restrict)
  farmer                  UrbanFarmer?            @relation(fields: [farmerId], references: [id], onDelete: SetNull)
  source                  AgriculturalDataSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  harvests                HarvestRecord[]

  @@unique([sourceId, externalRecordId])
  @@index([siteId, plantingDate])
  @@index([cropId, plantingDate])
  @@index([farmerId])
  @@index([sourceId])
  @@index([status])
}

model HarvestRecord {
  id                 String                  @id @default(cuid())
  cultivationId      String?
  siteId             String
  cropId             String
  farmerId           String?
  sourceId           String?
  externalRecordId   String?                 @db.VarChar(160)
  harvestedAt        DateTime                @db.Date
  quantity           Decimal                 @db.Decimal(14, 3)
  unit               String                  @db.VarChar(30)
  marketableQuantity Decimal?                @db.Decimal(14, 3)
  rejectedQuantity   Decimal?                @db.Decimal(14, 3)
  attributes         Json?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  cultivation        CultivationRecord?      @relation(fields: [cultivationId], references: [id], onDelete: SetNull)
  site               FarmingSite             @relation(fields: [siteId], references: [id], onDelete: Restrict)
  crop               Crop                    @relation(fields: [cropId], references: [id], onDelete: Restrict)
  farmer             UrbanFarmer?            @relation(fields: [farmerId], references: [id], onDelete: SetNull)
  source             AgriculturalDataSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@unique([sourceId, externalRecordId])
  @@index([cropId, harvestedAt])
  @@index([siteId, harvestedAt])
  @@index([farmerId])
  @@index([cultivationId])
  @@index([sourceId])
}

model SeasonalCropCalendar {
  id                 String                  @id @default(cuid())
  cropId             String
  barangayId         String?
  siteId             String?
  sourceId           String?
  externalRecordId   String?                 @db.VarChar(160)
  seasonName         String?                 @db.VarChar(120)
  effectiveYear      Int?
  plantingStartMonth Int
  plantingEndMonth   Int
  harvestStartMonth  Int
  harvestEndMonth    Int
  notes              String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  crop               Crop                    @relation(fields: [cropId], references: [id], onDelete: Restrict)
  barangay           Barangay?               @relation(fields: [barangayId], references: [id], onDelete: Restrict)
  site               FarmingSite?            @relation(fields: [siteId], references: [id], onDelete: SetNull)
  source             AgriculturalDataSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@unique([sourceId, externalRecordId])
  @@index([cropId, effectiveYear])
  @@index([barangayId])
  @@index([siteId])
  @@index([sourceId])
}

model MarketPriceObservation {
  id               String                  @id @default(cuid())
  cropId           String
  barangayId       String?
  sourceId         String?
  externalRecordId String?                 @db.VarChar(160)
  observedAt       DateTime                @db.Date
  marketName       String?                 @db.VarChar(255)
  priceType        String?                 @db.VarChar(80)
  price            Decimal                 @db.Decimal(14, 2)
  currency         String                  @default("PHP") @db.VarChar(3)
  unit             String                  @db.VarChar(30)
  attributes       Json?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  crop             Crop                    @relation(fields: [cropId], references: [id], onDelete: Restrict)
  barangay         Barangay?               @relation(fields: [barangayId], references: [id], onDelete: Restrict)
  source           AgriculturalDataSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@unique([sourceId, externalRecordId])
  @@index([cropId, observedAt])
  @@index([barangayId, observedAt])
  @@index([sourceId])
}

model CropAvailabilityObservation {
  id                String                  @id @default(cuid())
  cropId            String
  barangayId        String?
  siteId            String?
  sourceId          String?
  externalRecordId  String?                 @db.VarChar(160)
  periodStart       DateTime                @db.Date
  periodEnd         DateTime                @db.Date
  availableQuantity Decimal                 @db.Decimal(14, 3)
  unit              String                  @db.VarChar(30)
  availabilityLevel String?                 @db.VarChar(80)
  attributes        Json?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  crop              Crop                    @relation(fields: [cropId], references: [id], onDelete: Restrict)
  barangay          Barangay?               @relation(fields: [barangayId], references: [id], onDelete: Restrict)
  site              FarmingSite?            @relation(fields: [siteId], references: [id], onDelete: SetNull)
  source            AgriculturalDataSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@unique([sourceId, externalRecordId])
  @@index([cropId, periodStart])
  @@index([barangayId, periodStart])
  @@index([siteId])
  @@index([sourceId])
}

model SupplyReport {
  id               String                  @id @default(cuid())
  cropId           String
  barangayId       String?
  sourceId         String?
  externalRecordId String?                 @db.VarChar(160)
  periodStart      DateTime                @db.Date
  periodEnd        DateTime                @db.Date
  unit             String                  @db.VarChar(30)
  openingStock     Decimal?                @db.Decimal(14, 3)
  producedQuantity Decimal?                @db.Decimal(14, 3)
  inboundQuantity  Decimal?                @db.Decimal(14, 3)
  outboundQuantity Decimal?                @db.Decimal(14, 3)
  wasteQuantity    Decimal?                @db.Decimal(14, 3)
  closingStock     Decimal?                @db.Decimal(14, 3)
  attributes       Json?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  crop             Crop                    @relation(fields: [cropId], references: [id], onDelete: Restrict)
  barangay         Barangay?               @relation(fields: [barangayId], references: [id], onDelete: Restrict)
  source           AgriculturalDataSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@unique([sourceId, externalRecordId])
  @@index([cropId, periodStart])
  @@index([barangayId, periodStart])
  @@index([sourceId])
}

model AgriculturalSaleRecord {
  id               String                  @id @default(cuid())
  cropId           String
  barangayId       String?
  siteId           String?
  farmerId         String?
  sourceId         String?
  externalRecordId String?                 @db.VarChar(160)
  soldAt           DateTime                @db.Date
  quantity         Decimal                 @db.Decimal(14, 3)
  unit             String                  @db.VarChar(30)
  unitPrice        Decimal?                @db.Decimal(14, 2)
  totalAmount      Decimal                 @db.Decimal(14, 2)
  currency         String                  @default("PHP") @db.VarChar(3)
  channel          String?                 @db.VarChar(120)
  attributes       Json?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  crop             Crop                    @relation(fields: [cropId], references: [id], onDelete: Restrict)
  barangay         Barangay?               @relation(fields: [barangayId], references: [id], onDelete: Restrict)
  site             FarmingSite?            @relation(fields: [siteId], references: [id], onDelete: SetNull)
  farmer           UrbanFarmer?            @relation(fields: [farmerId], references: [id], onDelete: SetNull)
  source           AgriculturalDataSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@unique([sourceId, externalRecordId])
  @@index([cropId, soldAt])
  @@index([barangayId, soldAt])
  @@index([siteId])
  @@index([farmerId])
  @@index([sourceId])
}

model AgriculturalStatistic {
  id               String                  @id @default(cuid())
  cropId           String?
  barangayId       String?
  siteId           String?
  sourceId         String?
  externalRecordId String?                 @db.VarChar(160)
  metricName       String                  @db.VarChar(160)
  periodStart      DateTime                @db.Date
  periodEnd        DateTime                @db.Date
  value            Decimal                 @db.Decimal(18, 4)
  unit             String                  @db.VarChar(60)
  dimensions       Json?
  notes            String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  crop             Crop?                   @relation(fields: [cropId], references: [id], onDelete: Restrict)
  barangay         Barangay?               @relation(fields: [barangayId], references: [id], onDelete: Restrict)
  site             FarmingSite?            @relation(fields: [siteId], references: [id], onDelete: SetNull)
  source           AgriculturalDataSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([sourceId, externalRecordId])
  @@index([metricName, periodStart])
  @@index([cropId, periodStart])
  @@index([barangayId, periodStart])
  @@index([siteId])
  @@index([sourceId])
}

model HistoricalReport {
  id               String       @id @default(cuid())
  reportName       String       @db.VarChar(255)
  reportType       String       // "DAILY" | "WEEKLY" | "MONTHLY"
  uploadDate       DateTime     @default(now())
  uploadedBy       String       @db.VarChar(255)
  dataSource       String       @db.VarChar(255)
  dateRange        String       @db.VarChar(120) // e.g. "Jan 2023 - Jun 2026"
  recordsCount     Int
  productsIncluded String       @db.Text // Comma-separated product names
  fileContent      String       @db.Text // Store full CSV content for download and view
}

model ForecastRun {
  id                 String                  @id @default(cuid())
  forecastDate       DateTime                @default(now())
  datasetUsed        String                  @db.VarChar(255)
  productsForecasted Int
  sarimaModel        String                  @db.VarChar(120)
  mape               Decimal                 @db.Decimal(5, 2)
  duration           Int                     // in milliseconds
  status             String                  // "RUNNING" | "SUCCESS" | "FAILED"
  results            ForecastResult[]
  recommendations    ForecastRecommendation[]
  logs               ForecastLog[]
}

model ForecastResult {
  id                 String             @id @default(cuid())
  runId              String
  product            String             @db.VarChar(160)
  historicalDemand   Json               // Array of monthly history { month: "2026-06", value: 120 }
  forecastNextMonth  Decimal            @db.Decimal(14, 2)
  forecastNext3Months Json              // Array of next 3 months { month: "2026-07", value: 130 }
  trend              String             // "INCREASING" | "DECREASING" | "STABLE"
  confidence         Decimal            @db.Decimal(5, 2)
  mape               Decimal            @db.Decimal(5, 2)
  mae                Decimal            @db.Decimal(12, 2)
  rmse               Decimal            @db.Decimal(12, 2)
  status             String             // "GOOD" | "WARNING" | "NEEDS_RETRAINING"
  modelUsed          String             @db.VarChar(120) // e.g. "SARIMA(1,1,1)(1,1,1)12"
  trainingDatasetSize Int
  testingDatasetSize  Int
  run                ForecastRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
}

model ForecastRecommendation {
  id             String      @id @default(cuid())
  runId          String
  product        String      @db.VarChar(160)
  recommendation String      @db.Text
  run            ForecastRun @relation(fields: [runId], references: [id], onDelete: Cascade)
}

model ForecastSchedule {
  id         String   @id @default(cuid())
  schedule   String   @db.VarChar(20) // "MANUAL" | "DAILY" | "WEEKLY" | "MONTHLY"
  updatedAt  DateTime @updatedAt
}

model ForecastLog {
  id        String      @id @default(cuid())
  runId     String
  stepName  String      @db.VarChar(120)
  status    String      @db.VarChar(20) // "PENDING" | "RUNNING" | "SUCCESS" | "FAILED"
  output    String?     @db.Text
  updatedAt DateTime    @updatedAt
  run       ForecastRun @relation(fields: [runId], references: [id], onDelete: Cascade)
}
