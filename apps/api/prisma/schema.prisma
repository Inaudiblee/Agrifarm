generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BUYER
  SELLER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum StoreStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
  CLOSED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  OUT_OF_STOCK
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum SellerOrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  GCASH
  MAYA
  CARD
  BANK_TRANSFER
}

enum FulfillmentStatus {
  PENDING
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  FAILED
  CANCELLED
}

enum InventoryChangeReason {
  INITIAL_STOCK
  RESTOCK
  SALE
  RETURN
  ADJUSTMENT
  DAMAGE
  CANCELLATION
}

enum FinancialTransactionType {
  SALE
  COMMISSION
  REFUND
  PAYOUT
  ADJUSTMENT
}

enum CommissionPlanStatus {
  ACTIVE
  INACTIVE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  STATUS_CHANGE
  APPROVAL
  REJECTION
  PAYOUT
  REFUND
}

enum NotificationType {
  ORDER_UPDATE
  PAYMENT_UPDATE
  FULFILLMENT_UPDATE
  INVENTORY_ALERT
  ACCOUNT_UPDATE
  SYSTEM
}

model User {
  id                   String            @id @default(cuid())
  email                String            @unique @db.VarChar(255)
  passwordHash         String
  fullName             String            @db.VarChar(255)
  phone                String?           @db.VarChar(30)
  role                 UserRole          @default(BUYER)
  status               UserStatus        @default(ACTIVE)
  emailVerifiedAt      DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  deletedAt            DateTime?
  sellerProfile        SellerProfile?
  addresses            Address[]
  carts                Cart[]
  orders               Order[]           @relation("BuyerOrders")
  assignedFulfillments Fulfillment[]     @relation("AssignedRider")
  inventoryChanges     InventoryLedger[]
  reviews              Review[]
  auditLogs            AuditLog[]
  notifications        Notification[]
  refreshTokens        RefreshToken[]

  @@index([role])
  @@index([status])
  @@index([createdAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique @db.VarChar(128)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model SellerProfile {
  id               String    @id @default(cuid())
  userId           String    @unique
  businessName     String    @db.VarChar(255)
  businessPermitNo String?   @db.VarChar(100)
  taxId            String?   @db.VarChar(100)
  verifiedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stores           Store[]
}

model Store {
  id              String                 @id @default(cuid())
  sellerProfileId String
  name            String                 @db.VarChar(160)
  slug            String                 @unique @db.VarChar(180)
  description     String?
  status          StoreStatus            @default(DRAFT)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  deletedAt       DateTime?
  sellerProfile   SellerProfile          @relation(fields: [sellerProfileId], references: [id], onDelete: Restrict)
  products        Product[]
  productVariants ProductVariant[]       @relation("StoreProductVariants")
  sellerOrders    SellerOrder[]
  commissionRules StoreCommission[]
  financialLedger FinancialTransaction[]
  serviceAreas    StoreServiceArea[]

  @@index([sellerProfileId])
  @@index([status])
}

model Barangay {
  id             String             @id @default(cuid())
  name           String             @db.VarChar(120)
  normalizedName String             @unique @db.VarChar(120)
  city           String             @default("Pasig") @db.VarChar(120)
  province       String             @default("Metro Manila") @db.VarChar(120)
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  addresses      Address[]
  storeAreas     StoreServiceArea[]

  @@index([city, province])
  @@index([isActive])
}

model StoreServiceArea {
  id          String   @id @default(cuid())
  storeId     String
  barangayId  String
  deliveryFee Decimal  @default(0) @db.Decimal(12, 2)
  minOrder    Decimal? @db.Decimal(12, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  barangay    Barangay @relation(fields: [barangayId], references: [id], onDelete: Restrict)

  @@unique([storeId, barangayId])
  @@index([barangayId])
  @@index([isActive])
}

model Category {
  id          String            @id @default(cuid())
  parentId    String?
  name        String            @db.VarChar(120)
  slug        String            @unique @db.VarChar(140)
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  parent      Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[]        @relation("CategoryTree")
  products    ProductCategory[]

  @@index([parentId])
}

model Product {
  id           String                   @id @default(cuid())
  storeId      String
  name         String                   @db.VarChar(255)
  slug         String                   @db.VarChar(280)
  description  String?
  status       ProductStatus            @default(DRAFT)
  searchVector Unsupported("tsvector")?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  deletedAt    DateTime?
  store        Store                    @relation(fields: [storeId], references: [id], onDelete: Restrict)
  variants     ProductVariant[]
  categories   ProductCategory[]
  images       ProductImage[]
  reviews      Review[]

  @@unique([storeId, slug])
  @@unique([id, storeId])
  @@index([storeId])
  @@index([status])
  @@index([createdAt])
}

model ProductVariant {
  id                String            @id @default(cuid())
  productId         String
  storeId           String
  name              String            @db.VarChar(120)
  sku               String?           @db.VarChar(120)
  unit              String            @default("kg") @db.VarChar(30)
  price             Decimal           @db.Decimal(12, 2)
  compareAtPrice    Decimal?          @db.Decimal(12, 2)
  stockOnHand       Int               @default(0)
  lowStockThreshold Int               @default(5)
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  store             Store             @relation("StoreProductVariants", fields: [storeId], references: [id], onDelete: Restrict)
  product           Product           @relation(fields: [productId, storeId], references: [id, storeId], onDelete: Cascade)
  cartItems         CartItem[]
  orderItems        OrderItem[]
  inventoryLedger   InventoryLedger[]

  @@unique([productId, name])
  @@unique([id, storeId])
  @@unique([storeId, sku])
  @@index([productId])
  @@index([storeId])
  @@index([price])
  @@index([isActive])
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
}

model ProductImage {
  id           String   @id @default(cuid())
  productId    String
  url          String
  altText      String?  @db.VarChar(255)
  displayOrder Int      @default(0)
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Address {
  id            String    @id @default(cuid())
  userId        String
  barangayId    String?
  label         String?   @db.VarChar(80)
  recipientName String    @db.VarChar(255)
  phone         String    @db.VarChar(30)
  street        String
  barangay      String    @db.VarChar(120)
  city          String    @db.VarChar(120)
  province      String    @db.VarChar(120)
  postalCode    String?   @db.VarChar(20)
  country       String    @default("Philippines") @db.VarChar(80)
  latitude      Decimal?  @db.Decimal(10, 7)
  longitude     Decimal?  @db.Decimal(10, 7)
  isDefault     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  barangayRef   Barangay? @relation(fields: [barangayId], references: [id], onDelete: Restrict)
  orders        Order[]

  @@unique([id, userId])
  @@index([userId])
  @@index([barangayId])
  @@index([city, province])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@unique([userId])
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId])
  @@index([variantId])
}

model Order {
  id                String                 @id @default(cuid())
  orderNumber       String                 @unique @db.VarChar(40)
  buyerId           String
  shippingAddressId String
  status            OrderStatus            @default(PENDING)
  paymentStatus     PaymentStatus          @default(PENDING)
  subtotal          Decimal                @db.Decimal(12, 2)
  deliveryFee       Decimal                @default(0) @db.Decimal(12, 2)
  discountTotal     Decimal                @default(0) @db.Decimal(12, 2)
  grandTotal        Decimal                @db.Decimal(12, 2)
  notes             String?
  placedAt          DateTime               @default(now())
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  cancelledAt       DateTime?
  buyer             User                   @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Restrict)
  shippingAddress   Address                @relation(fields: [shippingAddressId, buyerId], references: [id, userId], onDelete: Restrict)
  items             OrderItem[]
  sellerOrders      SellerOrder[]
  payments          Payment[]
  financialLedger   FinancialTransaction[]

  @@index([buyerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([placedAt])
}

model SellerOrder {
  id              String                 @id @default(cuid())
  orderId         String
  storeId         String
  status          SellerOrderStatus      @default(PENDING)
  subtotal        Decimal                @db.Decimal(12, 2)
  deliveryFee     Decimal                @default(0) @db.Decimal(12, 2)
  commissionFee   Decimal                @default(0) @db.Decimal(12, 2)
  payoutAmount    Decimal                @db.Decimal(12, 2)
  confirmedAt     DateTime?
  cancelledAt     DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  order           Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  store           Store                  @relation(fields: [storeId], references: [id], onDelete: Restrict)
  items           OrderItem[]
  fulfillment     Fulfillment?
  financialLedger FinancialTransaction[]

  @@unique([orderId, storeId])
  @@unique([id, storeId])
  @@index([orderId])
  @@index([storeId])
  @@index([status])
}

model OrderItem {
  id            String         @id @default(cuid())
  orderId       String
  sellerOrderId String
  variantId     String
  storeId       String
  productName   String         @db.VarChar(255)
  variantName   String         @db.VarChar(120)
  unit          String         @db.VarChar(30)
  quantity      Int
  unitPrice     Decimal        @db.Decimal(12, 2)
  subtotal      Decimal        @db.Decimal(12, 2)
  createdAt     DateTime       @default(now())
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerOrder   SellerOrder    @relation(fields: [sellerOrderId, storeId], references: [id, storeId], onDelete: Cascade)
  variant       ProductVariant @relation(fields: [variantId, storeId], references: [id, storeId], onDelete: Restrict)

  @@index([orderId])
  @@index([sellerOrderId])
  @@index([variantId])
  @@index([storeId])
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  amount      Decimal       @db.Decimal(12, 2)
  provider    String?       @db.VarChar(80)
  providerRef String?       @unique @db.VarChar(180)
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@index([method])
}

model Fulfillment {
  id            String            @id @default(cuid())
  sellerOrderId String            @unique
  riderId       String?
  status        FulfillmentStatus @default(PENDING)
  trackingCode  String?           @unique @db.VarChar(80)
  assignedAt    DateTime?
  pickedUpAt    DateTime?
  deliveredAt   DateTime?
  failedAt      DateTime?
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  sellerOrder   SellerOrder       @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)
  rider         User?             @relation("AssignedRider", fields: [riderId], references: [id], onDelete: SetNull)

  @@index([riderId])
  @@index([status])
}

model FinancialTransaction {
  id            String                   @id @default(cuid())
  storeId       String
  orderId       String?
  sellerOrderId String?
  type          FinancialTransactionType
  amount        Decimal                  @db.Decimal(12, 2)
  balanceAfter  Decimal                  @db.Decimal(12, 2)
  reference     String?                  @db.VarChar(160)
  notes         String?
  createdAt     DateTime                 @default(now())
  store         Store                    @relation(fields: [storeId], references: [id], onDelete: Restrict)
  order         Order?                   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  sellerOrder   SellerOrder?             @relation(fields: [sellerOrderId], references: [id], onDelete: SetNull)

  @@index([storeId])
  @@index([orderId])
  @@index([sellerOrderId])
  @@index([type])
  @@index([createdAt])
}

model CommissionPlan {
  id             String               @id @default(cuid())
  name           String               @db.VarChar(120)
  description    String?
  ratePercent    Decimal              @db.Decimal(5, 2)
  fixedFee       Decimal              @default(0) @db.Decimal(12, 2)
  status         CommissionPlanStatus @default(ACTIVE)
  effectiveFrom  DateTime             @default(now())
  effectiveUntil DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  storeRules     StoreCommission[]

  @@index([status])
  @@index([effectiveFrom, effectiveUntil])
}

model StoreCommission {
  id               String         @id @default(cuid())
  storeId          String
  commissionPlanId String
  startsAt         DateTime       @default(now())
  endsAt           DateTime?
  createdAt        DateTime       @default(now())
  store            Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  commissionPlan   CommissionPlan @relation(fields: [commissionPlanId], references: [id], onDelete: Restrict)

  @@index([storeId])
  @@index([commissionPlanId])
  @@index([startsAt, endsAt])
}

model InventoryLedger {
  id            String                @id @default(cuid())
  variantId     String
  changedById   String?
  reason        InventoryChangeReason
  quantityDelta Int
  quantityAfter Int
  referenceType String?               @db.VarChar(80)
  referenceId   String?               @db.VarChar(120)
  notes         String?
  createdAt     DateTime              @default(now())
  variant       ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Cascade)
  changedBy     User?                 @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([variantId])
  @@index([changedById])
  @@index([reason])
  @@index([createdAt])
}

model Review {
  id        String    @id @default(cuid())
  userId    String
  productId String
  rating    Int
  title     String?   @db.VarChar(160)
  comment   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@index([rating])
}

model AuditLog {
  id         String      @id @default(cuid())
  actorId    String?
  action     AuditAction
  entityType String      @db.VarChar(120)
  entityId   String?     @db.VarChar(120)
  metadata   Json?
  ipAddress  String?     @db.VarChar(45)
  userAgent  String?
  createdAt  DateTime    @default(now())
  actor      User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String           @db.VarChar(160)
  body      String?
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([type])
  @@index([createdAt])
}
