<mxCell id="title14" value="&lt;div style=&quot;font-size:26px;font-weight:800;color:#101828&quot;&gt;Agrifarm Live Database ERD - Full Schema&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#667085;margin-top:4px&quot;&gt;All public tables, columns, primary keys, foreign keys, nullability, join tables, and relationship cardinality.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontFamily=Inter,Arial;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="50" y="30" width="940" height="70" as="geometry"/></mxCell>
<mxCell id="group15" value="&lt;b&gt;Identity &amp;amp; Access&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#5377b8;strokeWidth=1;arcSize=8;fontFamily=Inter,Arial;fontSize=15;fontStyle=1;verticalAlign=top;spacing=12;opacity=70;" parent="1" vertex="1"><mxGeometry x="70" y="122" width="480" height="2020" as="geometry"/></mxCell>
<mxCell id="table:User" value="&lt;div style=&quot;font-weight:700;font-size:14px;color:#1f2937;margin-bottom:6px&quot;&gt;★ User&lt;/div&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-size:11px;color:#0f4f8f;white-space:nowrap&quot;&gt;[PK] id: text NOT NULL&lt;/div&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-size:11px;color:#344054;white-space:nowrap&quot;&gt;[UK] email: character varying(255) NOT NULL&lt;/div&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-size:11px;color:#344054;white-space:nowrap&quot;&gt;passwordHash: text NOT NULL&lt;/div&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-size:11px;color:#344054;white-space:nowrap&quot;&gt;fullName: character varying(255) NOT NULL&lt;/div&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-size:11px;color:#344054;white-space:nowrap&quot;&gt;phone: character varying(30) NULL&lt;/div&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-size:11px;color:#344054;white-space:nowrap&quot;&gt;role: USER-DEFINED NOT NULL&lt;/div&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-size:11px;color:#344054;white-space:nowrap&quot;&gt;status: USER-DEFINED NOT NULL&lt;/div&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-size:11px;color:#344054;white-space:nowrap&quot;&gt;emailVerifiedAt: timestamp without time zone NULL&lt;/div&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-size:11px;color:#344054;white-space:nowrap&quot;&gt;createdAt: timestamp without time zone NOT NULL&lt;/div&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-size:11px;color:#344054;white-space:nowrap&quot;&gt;updatedAt: timestamp without time zone NOT NULL&lt;/div&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-size:11px;color:#344054;white-space:nowrap&quot;&gt;deletedAt: timestamp without time zone NULL&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;shadow=0;fillColor=#ffffff;strokeColor=#5377b8;strokeWidth=1.4;spacing=10;verticalAlign=top;fontFamily=Inter,Arial" parent="1" vertex="1"><mxGeometry x="90" y="170" width="400" height="288" as="geometry"/></mxCell>
<mxCell id="table:RefreshToken" value="&lt;div style=&quot;font-weight:700;font-size:14px;color:#1f2937;margin-bottom:6px&quot;&gt;RefreshToken&lt;/div&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-size:11px;color:#0f4f8f;white-space:nowrap&quot;&gt;[PK] id: text NOT NULL&lt;/div&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-size:11px;color:#6b4aa1;white-space:nowrap&quot;&gt;[FK] userId: text NOT NULL&lt;/div&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-size:11px;color:#344054;white-space:nowrap&quot;&gt;[UK] tokenHash: character varying(128) NOT NULL&lt;/div&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-size:11px;color:#344054;white-space:nowrap&quot;&gt;expiresAt: timestamp without time zone NOT NULL&lt;/div&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-size:11px;color:#344054;white-space:nowrap&quot;&gt;revokedAt: timestamp without time zone NULL&lt;/div&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-size:11px;color:#344054;white-space:nowrap&quot;&gt;createdAt: timestamp without time zone NOT NULL&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;shadow=0;fillColor=#eaf2ff;strokeColor=#5377b8;strokeWidth=1.4;spacing=10;verticalAlign=top;fontFamily=Inter,Arial" parent="1" vertex="1"><mxGeometry x="90" y="618" width="400" height="178" as="geometry"/></mxCell>
<mxCell id="table:SellerProfile" value="&lt;div style=&quot;font-weight:700;font-size:14px;color:#1f2937;margin-bottom:6px&quot;&gt;SellerProfile&lt;/div&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-size:11px;color:#0f4f8f;white-space:nowrap&quot;&gt;[PK] id: text NOT NULL&lt;/div&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-size:11px;color:#6b4aa1;white-space:nowrap&quot;&gt;[FK|UK] userId: text NOT NULL&lt;/div&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-size:11px;color:#344054;white-space:nowrap&quot;&gt;businessName: character varying(255) NOT NULL&lt;/div&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-size:11px;color:#344054;white-space:nowrap&quot;&gt;verifiedAt: timestamp without time zone NULL&lt;/div&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-size:11px;color:#344054;white-space:nowrap&quot;&gt;createdAt: timestamp without time zone NOT NULL&lt;/div&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-size:11px;color:#344054;white-space:nowrap&quot;&gt;updatedAt: timestamp without time zone NOT NULL&lt;/div&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-size:11px;color:#344054;white-space:nowrap&quot;&gt;gender: USER-DEFINED NULL&lt;/div&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-size:11px;color:#344054;white-space:nowrap&quot;&gt;avatarKey: character varying(20) NULL&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;shadow=0;fillColor=#eaf2ff;strokeColor=#5377b8;strokeWidth=1.4;spacing=10;verticalAlign=top;fontFamily=Inter,Arial" parent="1" vertex="1"><mxGeometry x="90" y="956" width="400" height="222" as="geometry"/></mxCell>
<mxCell id="table:Address" value="&lt;div style=&quot;font-weight:700;font-size:14px;color:#1f2937;margin-bottom:6px&quot;&gt;Address&lt;/div&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-size:11px;color:#0f4f8f;white-space:nowrap&quot;&gt;[PK] id: text NOT NULL&lt;/div&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-size:11px;color:#6b4aa1;white-space:nowrap&quot;&gt;[FK|UK] userId: text NOT NULL&lt;/div&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-size:11px;color:#344054;white-space:nowrap&quot;&gt;label: character varying(80) NULL&lt;/div&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-size:11px;color:#344054;white-space:nowrap&quot;&gt;recipientName: character varying(255) NOT NULL&lt;/div&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-size:11px;color:#344054;white-space:nowrap&quot;&gt;phone: character varying(30) NOT NULL&lt;/div&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-size:11px;color:#344054;white-space:nowrap&quot;&gt;street: text NOT NULL&lt;/div&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-size:11px;color:#344054;white-space:nowrap&quot;&gt;barangay: character varying(120) NOT NULL&lt;/div&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-size:11px;color:#344054;white-space:nowrap&quot;&gt;city: character varying(120) NOT NULL&lt;/div&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-size:11px;color:#344054;white-space:nowrap&quot;&gt;province: character varying(120) NOT NULL&lt;/div&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-size:11px;color:#344054;white-space:nowrap&quot;&gt;postalCode: character varying(20) NULL&lt;/div&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-size:11px;color:#344054;white-space:nowrap&quot;&gt;country: character varying(80) NOT NULL&lt;/div&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-size:11px;color:#344054;white-space:nowrap&quot;&gt;latitude: numeric(10,7) NULL&lt;/div&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-size:11px;color:#344054;white-space:nowrap&quot;&gt;longitude: numeric(10,7) NULL&lt;/div&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-size:11px;color:#344054;white-space:nowrap&quot;&gt;isDefault: boolean NOT NULL&lt;/div&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-size:11px;color:#667085&quot;&gt;+ 4 more columns&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;shadow=0;fillColor=#eaf2ff;strokeColor=#5377b8;strokeWidth=1.4;spacing=10;verticalAlign=top;fontFamily=Inter,Arial" parent="1" vertex="1"><mxGeometry x="90" y="1338" width="400" height="376" as="geometry"/></mxCell>
<mxCell id="group16" value="&lt;b&gt;Geography &amp;amp; Service Areas&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7f0;strokeColor=#3b8a68;strokeWidth=1;arcSize=8;fontFamily=Inter,Arial;fontSize=15;fontStyle=1;verticalAlign=top;spacing=12;opacity=70;" parent="1" vertex="1"><mxGeometry x="70" y="1502" width="480" height="1100" as="geometry"/></mxCell>
