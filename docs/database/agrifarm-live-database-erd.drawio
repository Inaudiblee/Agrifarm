<mxCell id="title107" value="&lt;div style=&quot;font-size:26px;font-weight:800;color:#101828&quot;&gt;Agrifarm Live Database ERD - Identity Access&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#667085;margin-top:4px&quot;&gt;Module-level ERD with local tables plus directly connected external tables.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;fontFamily=Inter,Arial;verticalAlign=top;" parent="1" vertex="1"><mxGeometry x="50" y="30" width="940" height="70" as="geometry"/></mxCell>
<mxCell id="table:User" value="&lt;div style=&quot;font-weight:700;font-size:14px;color:#1f2937;margin-bottom:6px&quot;&gt;★ User&lt;/div&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-size:11px;color:#0f4f8f;white-space:nowrap&quot;&gt;[PK] id: text NOT NULL&lt;/div&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-size:11px;color:#344054;white-space:nowrap&quot;&gt;[UK] email: character varying(255) NOT NULL&lt;/div&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-size:11px;color:#344054;white-space:nowrap&quot;&gt;passwordHash: text NOT NULL&lt;/div&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-size:11px;color:#344054;white-space:nowrap&quot;&gt;fullName: character varying(255) NOT NULL&lt;/div&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-size:11px;color:#344054;white-space:nowrap&quot;&gt;phone: character varying(30) NULL&lt;/div&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-size:11px;color:#344054;white-space:nowrap&quot;&gt;role: USER-DEFINED NOT NULL&lt;/div&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-size:11px;color:#344054;white-space:nowrap&quot;&gt;status: USER-DEFINED NOT NULL&lt;/div&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-size:11px;color:#344054;white-space:nowrap&quot;&gt;emailVerifiedAt: timestamp without time zone NULL&lt;/div&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-size:11px;color:#344054;white-space:nowrap&quot;&gt;createdAt: timestamp without time zone NOT NULL&lt;/div&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-size:11px;color:#344054;white-space:nowrap&quot;&gt;updatedAt: timestamp without time zone NOT NULL&lt;/div&gt;&lt;div style=&quot;font-family:Consolas,monospace;font-size:11px;color:#344054;white-space:nowrap&quot;&gt;deletedAt: timestamp without time zone NULL&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;shadow=0;fillColor=#ffffff;strokeColor=#5377b8;strokeWidth=1.4;spacing=10;verti